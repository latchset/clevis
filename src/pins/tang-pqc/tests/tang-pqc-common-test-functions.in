. tang-common-test-functions

tang_pqc_sanity_check() {
    tang_sanity_check
    command -v clevis-encrypt-tang-pqc >/dev/null 2>&1 \
        || skip_test "tang-pqc pin is not installed"
    command -v clevis-decrypt-tang-pqc >/dev/null 2>&1 \
        || skip_test "tang-pqc pin is not installed"
}

tang_pqc_check_version() {
    local port="${1}"
    local cacert="${2:-}"
    local cert="${3:-}"
    local key="${4:-}"
    [ -z "${port}" ] && error "tang_pqc_check_version: please specify 'port'"

    # Optional mTLS: with a CA bundle the probe must speak https and
    # authenticate with the client certificate when one is given.
    local scheme="http"
    local curl_opts=()
    if [ -n "${cacert}" ]; then
        scheme="https"
        curl_opts+=(--cacert "${cacert}")
    fi
    [ -n "${cert}" ] && curl_opts+=(--cert "${cert}")
    [ -n "${key}" ] && curl_opts+=(--key "${key}")

    local ver
    ver="$(curl -sf ${curl_opts[@]+"${curl_opts[@]}"} \
        "${scheme}://localhost:${port}/version")" \
        || return 1

    local hybrid
    hybrid="$(jose fmt -j- -Og features -Og hybrid_recovery -o- \
              <<< "${ver}" 2>/dev/null)" || return 1

    [ "${hybrid}" = "true" ]
}

tang_pqc_get_adv_kem() {
    local port="${1}"
    local adv_kem="${2:-/dev/stdout}"
    local alg="${3:-ML-KEM-768}"
    [ -z "${port}" ] && error "tang_pqc_get_adv_kem: please specify 'port'"
    curl -sfL -o "${adv_kem}" "http://localhost:${port}/adv-kem?alg=${alg}"
}
