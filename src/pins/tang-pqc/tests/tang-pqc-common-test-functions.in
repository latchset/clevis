. tang-common-test-functions

tang_pqc_sanity_check() {
    tang_sanity_check
    command -v clevis-encrypt-tang-pqc >/dev/null 2>&1 \
        || skip_test "tang-pqc pin is not installed"
    command -v clevis-decrypt-tang-pqc >/dev/null 2>&1 \
        || skip_test "tang-pqc pin is not installed"
}

tang_pqc_check_version() {
    local port="${1}"
    [ -z "${port}" ] && error "tang_pqc_check_version: please specify 'port'"

    local ver
    ver="$(curl -sf "http://localhost:${port}/version")" \
        || return 1

    local hybrid
    hybrid="$(jose fmt -j- -Og features -Og hybrid_recovery -o- \
              <<< "${ver}" 2>/dev/null)" || return 1

    [ "${hybrid}" = "true" ]
}

tang_pqc_get_adv_kem() {
    local port="${1}"
    local adv_kem="${2:-/dev/stdout}"
    [ -z "${port}" ] && error "tang_pqc_get_adv_kem: please specify 'port'"
    curl -L -o "${adv_kem}" "http://localhost:${port}/adv-kem"
}
