[ $# -eq 1 ] && [ "$1" == "--summary" ] && exit 2

if [ -t 0 ]; then
    exec >&2
    echo
    echo "Usage: clevis decrypt tang < JWE > PLAINTEXT"
    echo
    exit 2
fi

read -r -d . hdr

if ! jhd="$(jose b64 dec -i- <<< "$hdr")"; then
    echo "Error decoding JWE protected header!" >&2
    exit 1
fi

if [ "$(jose fmt -j- -Og clevis -g pin -u- <<< "$jhd")" != "tang" ]; then
    echo "JWE pin mismatch!" >&2
    exit 1
fi

if ! clt="$(jose fmt -j- -Og epk -Oo- <<< "$jhd")"; then
    echo "JWE missing required 'epk' header parameter!" >&2
    exit 1
fi

if ! kid="$(jose fmt -j- -Og kid -Su- <<< "$jhd")"; then
    echo "JWE missing required 'kid' header parameter!" >&2
    exit 1
fi

clevis_kem_ct="$(jose fmt -j- -Og clevis -g tang -g clevis_kem_ct -Su- <<< "$jhd" 2>/dev/null)" || true
kem_kid="$(jose fmt -j- -Og kem_kid -Su- <<< "$jhd" 2>/dev/null)" || true

CLEVIS_DEFAULT_THP_ALG=S256       # SHA-256.
CLEVIS_DEFAULT_THP_LEN=43         # Length of SHA-256 thumbprint.
CLEVIS_ALTERNATIVE_THP_ALGS=S1    # SHA-1.

# The adv field is optional when the server provides tang_pub in recovery.
# However, if adv IS present, the kid must match — a mismatch indicates
# a corrupted or tampered header and must fail immediately.
srv=
if keys="$(jose fmt -j- -Og clevis -g tang -g adv -Oo- <<< "${jhd}" 2>/dev/null)"; then
    if [ "${#kid}" -lt "${CLEVIS_DEFAULT_THP_LEN}" ]; then
        echo "WARNING: tang using a deprecated hash for the JWK thumbprints" >&2
    fi

    if ! srv="$(jose jwk thp -i- -f "${kid}" -a "${CLEVIS_DEFAULT_THP_ALG}" \
                <<< "${keys}")"; then
        for alg in ${CLEVIS_ALTERNATIVE_THP_ALGS}; do
            srv="$(jose jwk thp -i- -f "$kid" -a "${alg}" <<< "${keys}")" \
                && break
        done
        if [ -z "${srv}" ]; then
            echo "JWE header validation of 'clevis.tang.adv' failed: key thumbprint does not match" >&2
            exit 1
        fi
    fi
fi

if ! url="$(jose fmt -j- -Og clevis -g tang -g url -Su- <<< "$jhd")"; then
    echo "JWE missing required 'clevis.tang.url' header parameter!" >&2
    exit 1
fi

# Optional (m)TLS parameters. Absent for JWEs created without mTLS, in which
# case curl behaves exactly as before.
cacert="$(jose fmt -j- -Og clevis -g tang -g cacert -Su- <<< "$jhd")" || true
cert="$(jose fmt -j- -Og clevis -g tang -g cert -Su- <<< "$jhd")" || true
key="$(jose fmt -j- -Og clevis -g tang -g key -Su- <<< "$jhd")" || true

# Fail with a targeted diagnostic if a referenced (m)TLS file is missing.
# Otherwise curl -sfg fails silently below and the generic "Error
# communicating with server" sends the operator chasing network issues,
# when the real cause is a rotated cert or a file left out of the initramfs.
[ -n "$cacert" ] && [ ! -f "$cacert" ] && { echo "mTLS CA cert '$cacert' not found (is it in the initramfs?)" >&2; exit 1; }
[ -n "$cert" ]   && [ ! -f "$cert" ]   && { echo "mTLS client cert '$cert' not found (is it in the initramfs?)" >&2; exit 1; }
[ -n "$key" ]    && [ ! -f "$key" ]    && { echo "mTLS client key '$key' not found (is it in the initramfs?)" >&2; exit 1; }

curl_opts=()
[ -n "$cacert" ] && curl_opts+=(--cacert "$cacert")
[ -n "$cert" ]   && curl_opts+=(--cert "$cert")
[ -n "$key" ]    && curl_opts+=(--key "$key")

if ! crv="$(jose fmt -j- -Og crv -Su- <<< "$clt")"; then
    echo "Unable to determine EPK's curve!" >&2
    exit 1
fi

### ECMR blinding (shared across all paths)
if ! eph="$(jose jwk gen -i "{\"alg\":\"ECMR\",\"crv\":\"$crv\"}")"; then
    echo "Error generating ephemeral key!" >&2
    exit 1
fi

xfr="$(jose jwk exc -i '{"alg":"ECMR"}' -l- -r- <<< "$clt$eph")"

derive_enc_key() {
    local _ec_x="$1" _enc_key_k="$2" _kid="$3" _kem_kid="$4"
    local _ec_hex _kem_hex _ec_blen _kem_blen _ikm _info _dhex _db64

    _ec_hex="$(jose b64 dec -i- <<< "$_ec_x" | xxd -p -c 9999)"
    _kem_hex="$(jose b64 dec -i- <<< "$_enc_key_k" | xxd -p -c 9999)"
    _ec_blen=$(( ${#_ec_hex} / 2 ))
    _kem_blen=$(( ${#_kem_hex} / 2 ))
    _ikm="$(printf '%08x' "$_ec_blen")${_ec_hex}$(printf '%08x' "$_kem_blen")${_kem_hex}"
    _info="$(printf 'NBDE-HYBRID-v1\x00\x01ECMR+ML-KEM-768%s%s' "$_kid" "$_kem_kid" \
             | xxd -p -c 9999)"
    _dhex="$(openssl kdf -keylen 32 -kdfopt digest:SHA256 \
        -kdfopt mode:EXTRACT_AND_EXPAND \
        -kdfopt "hexkey:${_ikm}" -kdfopt "hexinfo:${_info}" HKDF \
        | tr -d ': \n' | tr 'A-F' 'a-f')"
    _db64="$(echo -n "$_dhex" | xxd -r -p | jose b64 enc -I-)"
    printf '{"alg":"A256GCM","k":"%s","kty":"oct"}' "$_db64"
}

ecmr_unblind() {
    local _rep="$1" _srv="$2"
    local _tmp _rep_pub

    _tmp="$(jose jwk exc -i '{"alg":"ECMR"}' -l- -r- <<< "$eph$_srv")"
    _rep_pub="$(jose jwk pub -i- <<< "$_rep")"
    jose jwk exc -l- -r- <<< "$_rep_pub$_tmp"
}

validate_tang_ec_pub() {
    local _tang_pub="$1" _kid="$2"

    if jose jwk thp -i- -f "$_kid" -a "${CLEVIS_DEFAULT_THP_ALG}" \
           <<< "$_tang_pub" >/dev/null 2>&1; then
        return 0
    fi
    for alg in ${CLEVIS_ALTERNATIVE_THP_ALGS}; do
        if jose jwk thp -i- -f "$_kid" -a "$alg" \
               <<< "$_tang_pub" >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}

ecmr_recover() {
    local _full_rep _tang_pub _rep

    if ! _full_rep="$(curl -sfg "${curl_opts[@]}" -X POST \
            -H "Content-Type: application/jwk+json" \
            --data-binary @- "$url/rec/$kid" <<< "$xfr")"; then
        echo "Error communicating with server $url" >&2
        return 1
    fi

    if _tang_pub="$(jose fmt -j- -Og tang_pub -Oo- \
                    <<< "$_full_rep" 2>/dev/null)"; then
        if ! validate_tang_ec_pub "$_tang_pub" "$kid"; then
            echo "tang_pub thumbprint does not match kid!" >&2
            return 1
        fi
        srv="$_tang_pub"
    fi

    if [ -z "$srv" ]; then
        echo "Unable to determine server exchange key" >&2
        return 1
    fi

    _rep="$(jose fmt -j- -Od tang_pub -o- <<< "$_full_rep" 2>/dev/null)" \
        || _rep="$_full_rep"

    if ! _rep="$(jose fmt -j- -Og kty -q EC -EUUg crv -q "$crv" -EUUo- \
                 <<< "$_rep")"; then
        echo "Received invalid server reply!" >&2
        return 1
    fi

    ecmr_unblind "$_rep" "$srv"
}

if [ -n "$clevis_kem_ct" ] && [ -n "$kem_kid" ]; then
    ### Hybrid ECC+KEM recovery (secure transport)

    tang_kem_pub="$(jose fmt -j- -Og clevis -g tang -g tang_kem_pub -Oo- \
                    <<< "$jhd")"
    ek_digest="$(jose fmt -j- -Og clevis -g tang -g ek_digest -Su- \
                 <<< "$jhd")"

    # --- Step 1: ECMR recovery via /rec ---
    ec_jwk="$(ecmr_recover)"
    ec_x="$(jose fmt -j- -Og x -Su- <<< "$ec_jwk")"

    # --- Step 2: Ephemeral KEM keypair ---
    clevis_kem_priv="$(jose jwk gen -i '{"alg":"ML-KEM-768"}')"
    clevis_kem_pub="$(jose jwk pub -i- <<< "$clevis_kem_priv")"

    # --- Step 3: Forward transport channel ---
    transport_encap="$(jose jwk encap -i- <<< "$tang_kem_pub")"
    clevis_transport_ct="$(jose fmt -j- -Og ct -Su- <<< "$transport_encap")"
    clevis_transport_key="$(jose fmt -j- -Og ss -Oo- <<< "$transport_encap")"

    # --- Step 4: Encrypt inner payload (clevis_kem_ct + clevis_kem_pub + ek_digest) ---
    inner_payload="$(printf '{"clevis_kem_ct":"%s","clevis_kem_pub":%s,"ek_digest":"%s"}' \
        "$clevis_kem_ct" "$clevis_kem_pub" "$ek_digest")"
    clevis_encrypted_blob="$(jose jwe enc \
        -i '{"protected":{"alg":"dir","enc":"A256GCM"}}' \
        -k- -I- -c < <(echo -n "$clevis_transport_key"; \
                       echo -n "$inner_payload"))"

    # --- Step 5: POST to /rec-kem ---
    req_body="$(printf '{"clevis_encrypted_blob":"%s","clevis_transport_ct":"%s"}' \
        "$clevis_encrypted_blob" "$clevis_transport_ct")"

    if ! kem_resp="$(curl -sfg "${curl_opts[@]}" -X POST \
            -H "Content-Type: application/json" \
            --data-binary "$req_body" \
            "$url/rec-kem/$kem_kid")"; then
        echo "Error communicating with server $url for KEM recovery" >&2
        exit 1
    fi

    # --- Step 6: Decapsulate return channel ---
    tang_encrypted_key="$(jose fmt -j- -Og tang_encrypted_key -Su- \
        <<< "$kem_resp")"
    tang_transport_ct="$(jose fmt -j- -Og tang_transport_ct -Su- \
        <<< "$kem_resp")"

    tang_transport_key="$(jose jwk decap -i- -c "$tang_transport_ct" \
        <<< "$clevis_kem_priv")"

    # --- Step 7: Decrypt enc_key ---
    enc_key_json="$(jose jwe dec -k- -i- \
        < <(echo -n "$tang_transport_key"; echo -n "$tang_encrypted_key"))"
    enc_key_k="$(jose fmt -j- -Og k -Su- <<< "$enc_key_json")"

    # --- Step 8: enc_key = PRF(enc_ec_key, enc_kem_key) ---
    enc_key="$(derive_enc_key "$ec_x" "$enc_key_k" "$kid" "$kem_kid")"

    # --- Step 9: Discard all ephemeral/transport material ---
    unset clevis_kem_priv clevis_kem_pub transport_encap
    unset clevis_transport_ct clevis_transport_key
    unset inner_payload clevis_encrypted_blob req_body kem_resp
    unset tang_encrypted_key tang_transport_ct tang_transport_key
    unset enc_key_json ec_jwk ec_x enc_key_k ek_digest tang_kem_pub

    (echo -n "$enc_key$hdr."; /bin/cat) | jose jwe dec -k- -i-
    exit $?
fi

### Classical ECMR recovery
ec_jwk="$(ecmr_recover)"

(echo -n "$ec_jwk$hdr."; /bin/cat) | jose jwe dec -k- -i-
exit $?
