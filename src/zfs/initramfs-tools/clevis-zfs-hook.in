PREREQ=""
prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
    ;;
esac

. @initramfstoolsdir@/hook-functions

# Pins come from the clevis hook, the key loading hook from the zfs one
[ -e @initramfstoolsdir@/scripts/zfs ] || exit 0
[ -x @bindir@/clevis-zfs-unlock ] || exit 0

copy_exec @bindir@/clevis-zfs-common-functions || exit 1
copy_exec @libexecdir@/clevis-zfs-load-key || exit 1
