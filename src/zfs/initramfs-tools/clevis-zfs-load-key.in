. /scripts/functions
. /scripts/clevis-functions

. clevis-zfs-common-functions
. clevis-luks-common-functions

root="$(zfs_get_prompt_encryptionroot "$1")" || exit 1

pins=$(zfs_read_used_pins "${root}")
if [[ " $pins " == *" tang "* ]]; then
    do_configure_networking
fi
if [[ " $pins " == *" tpm1 "* ]]; then
    do_configure_tpm1
fi

key="$(zfs_recover_key "${root}")" && zfs_load_key "${root}" <<< "${key}" || exit 1
log_success_msg "clevis: Unlocked ${root}"
